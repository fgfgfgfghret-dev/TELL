{
    "name": "tell-language",
    "displayName": "TELL Language",
    "description": "Подсветка и автодополнение для языка TELL",
    "version": "1.1.0",
    "engines": {
        "vscode": "^1.50.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:tell"
    ],
    "contributes": {
        "languages": [{
            "id": "tell",
            "aliases": ["TELL", "tell"],
            "extensions": [".tell"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "tell",
            "scopeName": "source.tell",
            "path": "./syntaxes/tell.tmLanguage.json"
        }]
    }
}